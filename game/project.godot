; Engine configuration file.
; DRACY: NOCTURNE - M01 playable prologue.

config_version=5

[application]

config/name="DRACY: NOCTURNE"
config/description="A dark fantasy visual novel. M01: The Girl Behind the Screen."
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
config/icon="res://assets/ui/icon.svg"
boot_splash/bg_color=Color(0.035, 0.018, 0.045, 1)
boot_splash/show_image=false

[autoload]

Settings="*res://scripts/core/settings_manager.gd"
Audio="*res://scripts/core/audio_manager.gd"

[audio]

driver/enable_input=false
buses/default_bus_layout="res://assets/audio/bus_layout.tres"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.012, 0.035, 1)

[gui]

theme/default_font_multichannel_signed_distance_field=true
common/drop_mouse_on_gui_input_disabled=true
