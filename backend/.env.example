# Copy to .env for local development. Never commit the real file.
HOST=127.0.0.1
PORT=8787
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-at-least-32-random-bytes
# Comma-separated exact origins. Leave empty for native/desktop requests.
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
NODE_ENV=development

# Optional OpenAI-compatible provider. If any value is missing, the backend
# continues to serve validated scripted fallback replies.
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4.1-mini
AI_API_KEY=
